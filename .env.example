# NIRNAYA — environment variable template
#
# Copy this file to .env (local development) and fill in real values.
# NEVER commit a file containing real secrets — only .env.example is tracked.

# --- Application -------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (Supabase PostgreSQL via Prisma) — required from Phase 2 -
# DATABASE_URL: pooled connection (Supabase pgbouncer, typically port 6543)
# DIRECT_URL:   direct connection (used by Prisma for schema/db push, port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- Seed (Phase 2) — optional, development only -------------------------
# SEED_ADMIN_PASSWORD: password for the bootstrap admin user
# SEED_ADMIN_PASSWORD="dev-admin-password"

# --- Authentication (jose JWT + bcrypt) — required from Phase 3 --------
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"

# --- AI provider — required from Phase 5 --------------------------------
# NIRNAYA integrates AI ticket classification/assignment through a
# provider-agnostic service abstraction (see docs/ARCHITECTURE.md).
#
# AI_PROVIDER: selects the classification provider ("mock" or "real")
# AI_API_KEY:  API key for the real AI provider (OpenAI-compatible)
# AI_API_BASE_URL: base URL for the API (default: https://api.openai.com/v1)
# AI_MODEL:    model name (default: gpt-4o-mini, Gemini example: gemini-3.6-flash)
#
# When AI_PROVIDER=real and AI_API_KEY is set, the system uses a real LLM.
# When AI_PROVIDER is unset or "mock", the system uses deterministic keywords.
# If AI_API_KEY is missing with AI_PROVIDER=real, the system falls back to mock.
# AI_PROVIDER=
# AI_API_KEY=
# AI_API_BASE_URL=
# AI_MODEL=

# --- Grafana (Phase G2/G2.1) — optional, infrastructure only -----------------
# Grafana is an optional visualization layer for analytics dashboards.
# NIRNAYA continues working normally if Grafana is unavailable.
#
# GRAFANA_ENABLED: set to "true" to enable Grafana-related routes (default: false)
#
# Admin service token (static, for server-to-server admin access):
# GRAFANA_SERVICE_TOKEN: bearer token for admin-scope Grafana datasource
#   Generate with: openssl rand -base64 32
# GRAFANA_ADMIN_USER_ID: user ID that the admin Grafana token maps to
# GRAFANA_ADMIN_ORGANIZATION_ID: organization ID for admin-scope queries
#
# Agent identity (dynamic, JWT-based — G2.1):
# Agents authenticate with NIRNAYA and receive short-lived JWTs.
# No per-agent environment variables required.
# GRAFANA_JWT_SECRET: signing key for Grafana identity JWTs (5-minute expiry)
#   Generate with: openssl rand -base64 32
#   Must be DIFFERENT from JWT_ACCESS_SECRET / JWT_REFRESH_SECRET
#
# Docker Compose (local development only):
# GRAFANA_ADMIN_PASSWORD: Grafana web UI admin password (default: nirnaya-dev)
#
# DEPRECATED (G2.1 — no longer needed for agent access):
# GRAFANA_AGENT_SERVICE_TOKEN — replaced by dynamic JWT issuance
# GRAFANA_AGENT_USER_ID — identity now comes from JWT claims
# GRAFANA_AGENT_ORGANIZATION_ID — identity now comes from JWT claims
#
# SECURITY:
#   - Never use NEXT_PUBLIC_* for any Grafana variables
#   - Never commit real tokens to Git
#   - GRAFANA_JWT_SECRET must differ from JWT_ACCESS_SECRET / JWT_REFRESH_SECRET
# GRAFANA_ENABLED=false
# GRAFANA_SERVICE_TOKEN="replace-with-random-base64-token"
# GRAFANA_ADMIN_USER_ID="admin-user-id-from-database"
# GRAFANA_ADMIN_ORGANIZATION_ID="org-id-from-database"
# GRAFANA_JWT_SECRET="replace-with-different-random-base64-token"
# GRAFANA_ADMIN_PASSWORD="nirnaya-dev"
