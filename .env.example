# NIRNAYA — environment variable template
#
# Copy this file to .env (local development) and fill in real values.
# NEVER commit a file containing real secrets — only .env.example is tracked.

# --- Application -------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (Supabase PostgreSQL via Prisma) — required from Phase 2 -
# DATABASE_URL: pooled connection (Supabase pgbouncer, typically port 6543)
# DIRECT_URL:   direct connection (used by Prisma for schema/db push, port 5432)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# --- Authentication (jose JWT + bcrypt) — required from Phase 3 --------
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"

# --- AI provider — required from Phase 5 --------------------------------
# NIRNAYA integrates AI ticket classification/assignment through a
# provider-agnostic service abstraction (see docs/ARCHITECTURE.md).
# The specific provider has not been selected yet (see docs/DECISIONS.md).
# AI_PROVIDER=
# AI_PROVIDER_API_KEY=
